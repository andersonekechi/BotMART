# ─── Server ──────────────────────────────────────────────
PORT=4100
NODE_ENV=production

# ─── MongoDB ─────────────────────────────────────────────
# Uses a dedicated database name so it doesn't conflict with anything else
MONGODB_URI=mongodb://localhost:27017/botmart

# ─── Telegram Bot ────────────────────────────────────────
BOT_TOKEN=your_telegram_bot_token_here
WEBHOOK_URL=https://YOUR_DOMAIN
ADMIN_TELEGRAM_IDS=123456789,987654321

# ─── JWT ─────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=7d

# ─── Stripe (optional) ──────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# ─── Crypto Payment (optional) ──────────────────────────
CRYPTO_WALLET_ADDRESS=your_crypto_wallet_address
CRYPTO_PAYMENT_API_KEY=your_crypto_payment_api_key

# ─── Claude AI ──────────────────────────────────────────
CLAUDE_API_KEY=your_claude_api_key_here

# ─── Store Settings ─────────────────────────────────────
STORE_COMMISSION=10

# ─── Dashboard ──────────────────────────────────────────
DASHBOARD_URL=https://YOUR_DOMAIN
